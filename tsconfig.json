{
 "compilerOptions": {
  "target": "ESNext",
  "module": "ESNext",
  "moduleResolution": "bundler",
  "strict": true,
  "noImplicitAny": true,
  "noUnusedLocals": true, 
    "noUnusedParameters": true, 
  "esModuleInterop": true,
  "skipLibCheck": true,
  "forceConsistentCasingInFileNames": true,

  "baseUrl": "./src",
  "paths": {
    "@/*": ["./*"]
  }
},
"include": ["src"]
}
